<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <AssemblyName>KS2Drive.Tests</AssemblyName>
    <RootNamespace>KS2Drive.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- KS2Drive.exe is AnyCPU (32-bit preferred): it loads fine in the x64 test host -->
    <NoWarn>$(NoWarn);CS8012</NoWarn>
    <!-- The application project signs its Click-Once manifests with a certificate that is not available on every machine -->
    <SignManifests>false</SignManifests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.9.4" />
    <PackageReference Include="MSTest.TestAdapter" Version="1.2.1" />
    <PackageReference Include="MSTest.TestFramework" Version="1.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KS2.Drive.csproj">
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <AdditionalProperties>SignManifests=false</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\..\WebDAVClient\WebDAVClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="winfsp-msil">
      <HintPath>..\..\Reference\winfsp-msil.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\packages\Newtonsoft.Json.10.0.3\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>..\..\packages\NLog.4.4.12\lib\net45\NLog.dll</HintPath>
    </Reference>
    <Reference Include="System.ValueTuple">
      <HintPath>..\..\packages\System.ValueTuple.4.4.0\lib\net461\System.ValueTuple.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Net.Http.WebRequest" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
